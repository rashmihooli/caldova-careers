{
  "name": "Caldova Careers",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium && npm run db:setup",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Caldova Careers",
      "onAutoForward": "notify"
    }
  }
}
