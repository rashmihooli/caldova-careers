---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Page not found — Caldova Careers">
  <div class="py-16 max-w-2xl text-center mx-auto">
    <h1 class="text-4xl font-bold text-slate-100 mb-4">404</h1>
    <p class="text-slate-400 mb-8">
      We couldn't find that page. The role may have been filled or the link may
      be out of date.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-lg font-medium bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 transition-colors"
    >
      Back to open roles
    </a>
  </div>
</Layout>
