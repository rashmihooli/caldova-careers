---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="About Caldova — Caldova Careers">
  <div class="py-12 max-w-2xl">
    <h1 class="text-3xl font-bold text-slate-100 mb-2">About Caldova</h1>
    <p class="text-lg text-slate-300 mb-6">AI-native pharmaceutical operations.</p>

    <p class="text-slate-400 mb-6">
      Caldova is a pharmaceutical operations company that brings connected
      teams, governed agents, and evidence-rich workflows together to get
      life-improving medications to market faster. We operate globally across
      the pharmaceutical lifecycle — research and development, manufacturing,
      production, commercialization, and market access.
    </p>

    <p class="text-slate-400">
      Our teams span research &amp; development, manufacturing and field service,
      technology, security, finance, marketing, and more — across sites in North
      America, Europe, and Asia. If you want to work on hard problems that
      matter, we'd love to hear from you.
    </p>
  </div>
</Layout>
