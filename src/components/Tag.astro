---
interface Props {
    /** Visual color of the tag. */
    color?: "blue" | "slate";
    /** Optional test id passthrough. */
    "data-testid"?: string;
}

const { color = "blue", ...rest } = Astro.props;

const colors: Record<NonNullable<Props["color"]>, string> = {
    blue: "bg-blue-500/15 text-blue-300 border border-blue-500/30",
    slate: "bg-slate-500/15 text-slate-300 border border-slate-500/30",
};
---

<span
    class:list={[
        "inline-flex items-center rounded-full px-3 py-1 text-xs font-medium",
        colors[color],
    ]}
    {...rest}
>
    <slot />
</span>
